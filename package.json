{
  "name": "dark-pattern-manor",
  "version": "1.0.0",
  "description": "A browser game about dark patterns",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:hooks && npm run test:qa && npm run test:agents && npm run test:power",
    "typecheck": "tsc --noEmit",
    "test:guard": "node --test scripts/hooks/guard-command.test.mjs",
    "test:hooks": "node --test scripts/hooks/*.test.mjs",
    "test:qa": "node --test scripts/mcp/*.test.mjs",
    "test:agents": "node --test scripts/agents/*.test.mjs",
    "test:power": "node --test scripts/power/*.test.mjs",
    "check:rooms": "node scripts/check-rooms.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:agents": "node scripts/agents/check-agents.mjs",
    "check:power": "node scripts/power/check-power.mjs",
    "qa:full": "node scripts/mcp/manor-qa-full.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "axe-core": "^4.14.0",
    "fast-check": "^3.23.2",
    "jsdom": "^23.2.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
